#!/bin/sh
# Source-only bootstrap: obtain and verify the OFFICIAL Gradle wrapper on first use.
# This is a small custom launcher, not the generated Gradle shell script.
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
JAR="$ROOT/gradle/wrapper/gradle-wrapper.jar"
EXPECTED=81a82aaea5abcc8ff68b3dfcb58b3c3c429378efd98e7433460610fecd7ae45f
if [ ! -f "$JAR" ]; then
    command -v curl >/dev/null 2>&1 || { echo "curl is required for first-run bootstrap." >&2; exit 1; }
    echo "Downloading the official Gradle 8.13 wrapper..."
    curl --fail --location --connect-timeout 20 --max-time 180 \
      https://raw.githubusercontent.com/gradle/gradle/v8.13.0/gradle/wrapper/gradle-wrapper.jar \
      --output "$JAR.part"
    CANDIDATE="$JAR.part"
else
    CANDIDATE="$JAR"
fi
if command -v sha256sum >/dev/null 2>&1; then ACTUAL=$(sha256sum "$CANDIDATE" | cut -d ' ' -f 1)
elif command -v shasum >/dev/null 2>&1; then ACTUAL=$(shasum -a 256 "$CANDIDATE" | cut -d ' ' -f 1)
else echo "sha256sum or shasum is required." >&2; exit 1
fi
[ "$ACTUAL" = "$EXPECTED" ] || { echo "Gradle wrapper checksum mismatch. Nothing executed." >&2; exit 1; }
if [ "$CANDIDATE" != "$JAR" ]; then mv "$CANDIDATE" "$JAR"; fi
if [ -n "${JAVA_HOME:-}" ]; then JAVA="$JAVA_HOME/bin/java"; else JAVA=java; fi
cd "$ROOT"
exec "$JAVA" -classpath "$JAR" org.gradle.wrapper.GradleWrapperMain "$@"
